# 将任意文件作为只读数据嵌入目标：embed_file(目标 资源名 文件路径)
set(EMBED_FILE_TEMPLATE "${CMAKE_CURRENT_LIST_DIR}/file_data.S.in")
function(embed_file target name path)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "embed_file: target '${target}' does not exist")
    endif()
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "embed_file: resource name must be a C identifier")
    endif()
    get_filename_component(FILE_EMBED_PATH "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${FILE_EMBED_PATH}")
        message(FATAL_ERROR "embed_file: file not found: ${FILE_EMBED_PATH}")
    endif()
    file(TO_CMAKE_PATH "${FILE_EMBED_PATH}" FILE_EMBED_PATH)
    set(FILE_EMBED_SYMBOL "file_embed_${name}")

    if(APPLE)
        set(FILE_EMBED_PREFIX "_")
        set(FILE_EMBED_SECTION ".const")
    elseif(WIN32)
        set(FILE_EMBED_PREFIX "")
        set(FILE_EMBED_SECTION ".section .rdata,\"dr\"")
    else()
        set(FILE_EMBED_PREFIX "")
        set(FILE_EMBED_SECTION ".section .rodata")
    endif()

    set(output "${CMAKE_CURRENT_BINARY_DIR}/generated/embedded_${name}.S")
    configure_file("${EMBED_FILE_TEMPLATE}" "${output}" @ONLY)
    set_source_files_properties("${output}" PROPERTIES OBJECT_DEPENDS "${FILE_EMBED_PATH}")
    target_sources("${target}" PRIVATE "${output}")
endfunction()
